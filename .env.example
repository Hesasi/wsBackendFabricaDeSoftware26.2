# Copie este arquivo para .env e ajuste os valores conforme necessário.
# O .env real nunca deve ser commitado (já está no .gitignore).

# Banco de dados (PostgreSQL)
# DB_HOST=db quando rodando via docker-compose; DB_HOST=localhost rodando fora do Docker.
DB_NAME=grimorio_db
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_HOST=db
DB_PORT=5432

# Django
# Gere uma nova chave em produção, ex: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave-por-uma-secreta-e-unica
DEBUG=True
